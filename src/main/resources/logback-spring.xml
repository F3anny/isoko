<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <springProperty name="appName" source="spring.application.name" defaultValue="cloudsphere"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%12.12t]){faint} %clr(%-32.32logger{31}){cyan} %clr(:){faint} %m%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"application":"${appName}"}</customFields>
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- IntelliJ / local: readable colourised lines. JSON for log shippers. -->
    <springProfile name="json,prod">
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
    <springProfile name="!(json | prod)">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <logger name="rw.ac.rca.cloudsphere" level="INFO"/>
    <logger name="org.springframework.security" level="WARN"/>
    <logger name="org.springframework.data.repository.config" level="WARN"/>
    <logger name="org.springframework.data.jpa.repository.query" level="WARN"/>
    <logger name="org.springframework.orm.jpa.persistenceunit" level="WARN"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.orm.core" level="WARN"/>
    <logger name="org.hibernate.orm.jpa" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.batch" level="WARN"/>
    <logger name="org.hibernate.orm.connections.pooling" level="WARN"/>
    <logger name="org.apache.catalina.core" level="WARN"/>
    <logger name="io.netty.resolver.dns" level="ERROR"/>
    <logger name="org.springdoc.core.events" level="ERROR"/>
</configuration>
